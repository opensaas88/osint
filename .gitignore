.venv/
__pycache__/
*.pyc
.env
# Un rapport décrit la surface d'attaque d'une organisation : il se traite comme
# un document confidentiel et n'a rien à faire dans un dépôt, public ou non.
/data/
/reports/
/rapports/
# Suivi interne : seule la convention d'usage est versionnée, jamais les rapports.
/suivi/*
!/suivi/README.md
!/suivi/.gitkeep
.pytest_cache/
.ruff_cache/
