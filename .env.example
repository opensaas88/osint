# ---------------------------------------------------------------------------
# DomainExposure — configuration
# Copier ce fichier en .env puis renseigner les cles souhaitees.
# Chaque module dont la cle est absente se desactive proprement et l'indique
# dans le rapport : aucune cle n'est obligatoire pour lancer une analyse.
# ---------------------------------------------------------------------------

# --- Serveur ---------------------------------------------------------------
HOST=127.0.0.1
PORT=8080
# Identite de l'operateur journalisee dans le journal d'audit.
OPERATOR=operateur-local

# --- Persistance -----------------------------------------------------------
DB_PATH=data/domainexposure.db
# Duree de vie du cache des reponses d'API (heures).
CACHE_TTL_HOURS=24
# Conservation du journal d'audit (jours). `python -m app purge` applique la regle.
AUDIT_RETENTION_DAYS=365

# --- Resolution DNS --------------------------------------------------------
# auto   : teste le resolveur systeme, bascule sur DNS-over-HTTPS s'il echoue
# system : resolveur systeme uniquement (UDP/53, via dnspython)
# doh    : DNS-over-HTTPS uniquement (utile derriere un reseau filtrant)
DNS_BACKEND=auto
DNS_TIMEOUT=5.0

# --- Reseau ----------------------------------------------------------------
HTTP_TIMEOUT=15.0
HTTP_RETRIES=3
CRTSH_TIMEOUT=60.0

# ---------------------------------------------------------------------------
# CLES API — toutes optionnelles
# ---------------------------------------------------------------------------

# Have I Been Pwned (payant) — https://haveibeenpwned.com/API/Key
# Sans cle : les fuites ayant touche le site lui-meme sont quand meme listees
# (endpoint public /breaches).
# Avec cle + domaine verifie dans le tableau de bord HIBP :
#   - Domain Search : comptes du domaine apparaissant dans des fuites ;
#   - journaux d'infostealers (palier « Pro ») : identifiants captures sur des
#     postes reellement infectes, pour vos collaborateurs et pour les
#     utilisateurs de votre site.
# Sans verification du domaine chez HIBP, ces recherches repondent 403.
HIBP_API_KEY=

# Shodan (payant, des 49 USD a vie) — https://account.shodan.io
# Sans cle : Shodan InternetDB (gratuit, sans authentification) fournit deja
# ports ouverts, CVE connues et tags. Avec cle : donnees detaillees par service.
# Attention : Shodan s'authentifie par parametre d'URL (?key=), pas par en-tete.
SHODAN_API_KEY=

# VirusTotal (gratuit, 4 req/min) — https://www.virustotal.com/gui/my-apikey
VIRUSTOTAL_API_KEY=

# AbuseIPDB (gratuit, 1 000 req/jour) — https://www.abuseipdb.com/account/api
ABUSEIPDB_API_KEY=

# URLhaus / abuse.ch (gratuit mais desormais OBLIGATOIRE) — https://auth.abuse.ch
URLHAUS_AUTH_KEY=

# LeakCheck (payant) — https://leakcheck.io  — metadonnees de fuites uniquement
LEAKCHECK_API_KEY=

# Intelligence X (payant) — https://intelx.io  — metadonnees de fuites uniquement
INTELX_API_KEY=

# --- Surveillance planifiee ------------------------------------------------
# L'ordonnanceur analyse automatiquement les domaines du portefeuille selon leur
# periodicite, et alerte en cas de regression. Il s'execute dans le processus
# applicatif : avec plusieurs workers uvicorn, desactivez-le sur les processus
# supplementaires pour ne pas dupliquer les analyses.
SCHEDULER_ENABLED=true
# Frequence de verification des echeances, en secondes.
SCHEDULER_TICK_SECONDS=300
# Nombre d'analyses planifiees menees en parallele.
SCHEDULER_CONCURRENCY=2
# Baisse de score, en points, declenchant une alerte.
ALERT_SCORE_DROP=5

# --- Notifications par courriel (facultatif) -------------------------------
# Sans serveur SMTP, seules les alertes par webhook sont emises.
# SMTP_PASSWORD est un secret : ne le versionnez pas.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true

# --- Reglages des modules --------------------------------------------------
# Typosquatting : nombre maximal de permutations testees (dnstwist).
TYPO_MAX_PERMUTATIONS=200
# Sous-domaines : nombre maximal de sous-domaines resolus apres dedoublonnage.
SUBDOMAIN_RESOLVE_LIMIT=150

# Vérification de la redirection HTTP -> HTTPS (désactiver si le réseau interdit
# les requêtes en clair sortantes).
CHECK_HTTP_REDIRECT=true
